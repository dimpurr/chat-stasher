{
  "name": "chat-stasher-ext",
  "description": "Chat Stasher: capture DeepSeek web chat to local files",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:dev": "CS_RELEASE_CHANNEL=dev wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "node scripts/check-test-inventory.mjs",
    "e2e": "pnpm run build:dev && playwright test -c e2e/playwright.config.ts",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@wxt-dev/i18n": "0.2.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "web-ext": "^10.5.0",
    "wxt": "0.21.4"
  },
  "license": "Apache-2.0"
}
