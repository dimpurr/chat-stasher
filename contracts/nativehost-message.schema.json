{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dimpurr/chat-stasher/contracts/nativehost-message.schema.json",
  "title": "chat-stasher native messaging message (protocol 1)",
  "description": "Every request and response exchanged between the extension and the chat-stasher native host. Normative text: nativehost-protocol.md. Changing this file requires changing that document, apps/extension/lib/native-host.ts and crates/chat-stasher/src/nativehost.rs together.",
  "oneOf": [
    {
      "$ref": "#/$defs/helloRequest"
    },
    {
      "$ref": "#/$defs/deliverRequest"
    },
    {
      "$ref": "#/$defs/helloResponse"
    },
    {
      "$ref": "#/$defs/ack"
    },
    {
      "$ref": "#/$defs/nack"
    },
    {
      "$ref": "#/$defs/summaryRequest"
    },
    {
      "$ref": "#/$defs/summaryResponse"
    },
    {
      "$ref": "#/$defs/dashboardRequest"
    },
    {
      "$ref": "#/$defs/dashboardResponse"
    },
    {
      "$ref": "#/$defs/otherInstallsRequest"
    },
    {
      "$ref": "#/$defs/otherInstallsResponse"
    },
    {
      "$ref": "#/$defs/identityStateRequest"
    },
    {
      "$ref": "#/$defs/identityStateResponse"
    },
    {
      "$ref": "#/$defs/hasRequest"
    },
    {
      "$ref": "#/$defs/hasResponse"
    },
    {
      "$ref": "#/$defs/coordinationRequest"
    },
    {
      "$ref": "#/$defs/coordinationResponse"
    },
    {
      "$ref": "#/$defs/statusRequest"
    },
    {
      "$ref": "#/$defs/statusResponse"
    }
  ],
  "$defs": {
    "protocol": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "reportNonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "countState": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "count"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "known"
            },
            "count": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "why"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unknown"
            },
            "why": {
              "type": "string"
            }
          }
        }
      ],
      "description": "A count that is measured (`known`, where count 0 means 'looked and found none') or explicitly unknown with a reason. Never collapsed into 0/null/absent (nativehost-protocol.md §6.4)."
    },
    "timeState": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "unix"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "known"
            },
            "unix": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "why"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unknown"
            },
            "why": {
              "type": "string"
            }
          }
        }
      ],
      "description": "A unix time that is either known or explicitly unknown with a reason."
    },
    "helloRequest": {
      "type": "object",
      "required": [
        "protocol",
        "type"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "type": {
          "const": "hello"
        }
      },
      "description": "Unknown request fields are ignored by the host (nativehost-protocol.md §6)."
    },
    "deliverRequest": {
      "type": "object",
      "required": [
        "protocol",
        "type",
        "request_id",
        "name",
        "payload",
        "sha256"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "type": {
          "const": "deliver"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+-[^/\\\\]+\\.json$"
        },
        "payload": {
          "type": "string",
          "description": "The inbox bundle serialised with JSON.stringify; see inbox.schema.json."
        },
        "sha256": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 of the UTF-8 bytes of payload."
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256",
          "description": "Optional. The content fingerprint of the capture this payload was built from, recorded on the sealed shard and answered back by `has` (§6.6). Not required: an extension that does not send it, and every shard sealed before this field existed, is recognised by its exact bytes alone (§7). Since W213 the bundle inside `payload` carries the same value under the same field name (inbox.schema.json), so a payload written to an §8 export file does not lose it on import; this message-level field remains the one a live `deliver` seals from."
        },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "W218 optional transient platform account id. The host derives a masterkey-scoped HMAC and does not return or persist this raw value."
        },
        "report_seq": {
          "type": "integer",
          "minimum": 0,
          "description": "EXT-13 optional. The sender's monotonic per-instance report sequence, incremented for every status report and every capture delivery (ADR-045). The host records it against (machine, install_id), together with `report_nonce`: one sequence under two different nonces is proof that two live writers share the id, and a repeat of the same pair is one allocation arriving twice. Absent — an older extension, or storage that could not be read — is recorded as unknown and is never sent as zero, because zero is a value a writer can send."
        },
        "report_nonce": {
          "$ref": "#/$defs/reportNonce",
          "description": "EXT-13 optional. The token minted with `report_seq` and persisted beside it, which is what makes a repeated sequence mean something: two copies of a profile allocate the same numbers, but each mints its own random nonce, so a sequence the host has already recorded under one nonce arriving under another is two allocations of one number. A repeat of the same pair is an idempotent retry. Meaningless without `report_seq`, and refused as malformed beside no sequence."
        }
      },
      "description": "Unknown request fields are ignored by the host (nativehost-protocol.md §6)."
    },
    "hasRequest": {
      "type": "object",
      "required": [
        "protocol",
        "type",
        "request_id",
        "platform",
        "session_id",
        "fingerprint"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "type": {
          "const": "has"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "The bundle's raw `platform`. The host sanitises it exactly as `deliver` does, so the lookup names the directory the delivery would be written into."
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "The bundle's raw `sessionId`, sanitised the same way."
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256",
          "description": "The content fingerprint to look for, compared as an opaque string."
        }
      },
      "description": "Unknown request fields are ignored by the host (nativehost-protocol.md §6)."
    },
    "hasResponse": {
      "type": "object",
      "required": [
        "protocol",
        "type",
        "ok",
        "request_id",
        "held",
        "shard"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "type": {
          "const": "has"
        },
        "ok": {
          "const": true
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        },
        "held": {
          "type": "boolean",
          "description": "true: a shard in that conversation's directory carries this fingerprint. false: the question was asked and answered — the stage holds nothing under it. A question that could not be asked is a `nack`, never `held: false`."
        },
        "shard": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The shard the fingerprint was found in, or null when `held` is false."
        }
      }
    },
    "helloResponse": {
      "type": "object",
      "required": [
        "protocol",
        "type",
        "ok",
        "host_version",
        "machine",
        "stage"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "type": {
          "const": "hello"
        },
        "ok": {
          "const": true
        },
        "host_version": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "stage": {
          "type": "string",
          "description": "Absolute path of the stage the host writes to."
        }
      }
    },
    "ack": {
      "type": "object",
      "required": [
        "protocol",
        "type",
        "request_id",
        "status",
        "sha256",
        "shard"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "type": {
          "const": "ack"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        },
        "status": {
          "enum": [
            "stored",
            "duplicate"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "shard": {
          "type": "string"
        }
      }
    },
    "nack": {
      "type": "object",
      "required": [
        "protocol",
        "type",
        "request_id",
        "kind",
        "retryable",
        "detail"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "type": {
          "const": "nack"
        },
        "request_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/requestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "protocol-version",
            "bad-request",
            "too-large",
            "integrity",
            "invalid-bundle",
            "install-conflict",
            "identity-conflict",
            "config",
            "stage-unavailable",
            "io"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "detail": {
          "type": "string",
          "maxLength": 4096
        },
        "supported": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Present on kind protocol-version."
        }
      }
    },
    "summaryRequest": {
      "type": "object",
      "required": [
        "protocol",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "type": {
          "const": "summary"
        }
      },
      "description": "Parameterless: unlike hello/deliver, any extra field is refused (nativehost-protocol.md §6.4)."
    },
    "summaryResponse": {
      "type": "object",
      "required": [
        "protocol",
        "type",
        "ok",
        "window_hours",
        "complete",
        "sessions",
        "last_push"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "type": {
          "const": "summary"
        },
        "ok": {
          "const": true
        },
        "window_hours": {
          "type": "integer",
          "description": "The window the last_24h counts cover. 24 today; the field exists so the extension never has to assume a number."
        },
        "complete": {
          "type": "boolean",
          "description": "True exactly when every count and last_push is `known`."
        },
        "sessions": {
          "type": "object",
          "required": [
            "total",
            "last_24h",
            "by_harness"
          ],
          "additionalProperties": false,
          "properties": {
            "total": {
              "$ref": "#/$defs/countState"
            },
            "last_24h": {
              "$ref": "#/$defs/countState"
            },
            "by_harness": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "harness",
                  "total",
                  "last_24h"
                ],
                "additionalProperties": false,
                "properties": {
                  "harness": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Leading dot-segment of the session directory name; null when it has no usable prefix. That bucket is still counted."
                  },
                  "total": {
                    "$ref": "#/$defs/countState"
                  },
                  "last_24h": {
                    "$ref": "#/$defs/countState"
                  }
                }
              },
              "description": "Empty — and only empty — when sessions.total is unknown. Otherwise the per-harness totals add up to sessions.total."
            }
          }
        },
        "last_push": {
          "$ref": "#/$defs/timeState",
          "description": "finished_at_unix of the most recent run-once pass recorded as `completed`."
        }
      }
    },
    "coordinationRequest": {
      "type": "object",
      "required": [
        "protocol",
        "type",
        "request_id",
        "mode",
        "platform",
        "install_id"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "type": {
          "const": "coordination"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        },
        "mode": {
          "enum": [
            "claim",
            "token",
            "release",
            "rate_limit"
          ]
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "install_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "segment": {
          "enum": [
            "enumerate",
            "detail"
          ]
        },
        "status": {
          "enum": [
            403,
            429
          ]
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 0
        },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "description": "Machine-wide backfill claim, request token, release or rate-limit report (nativehost-protocol.md §6.7)."
    },
    "coordinationResponse": {
      "type": "object",
      "required": [
        "protocol",
        "type",
        "ok",
        "request_id",
        "granted",
        "active_installs",
        "gentle",
        "cooldown_until",
        "wait_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "type": {
          "const": "coordination"
        },
        "ok": {
          "const": true
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        },
        "granted": {
          "type": "boolean"
        },
        "active_installs": {
          "type": "integer",
          "minimum": 0
        },
        "gentle": {
          "type": "boolean"
        },
        "cooldown_until": {
          "type": "integer"
        },
        "wait_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Arbitration measurement and token grant (nativehost-protocol.md §6.7)."
    },
    "dashboardRequest": {
      "type": "object",
      "required": [
        "protocol",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "type": {
          "const": "open_dashboard"
        }
      },
      "description": "Parameterless on purpose: the extension cannot name a destination, a repository or a key (nativehost-protocol.md §6.5)."
    },
    "dashboardResponse": {
      "type": "object",
      "required": [
        "protocol",
        "type",
        "ok",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "type": {
          "const": "open_dashboard"
        },
        "ok": {
          "const": true
        },
        "url": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]{1,5}/\\?token=[0-9a-f]{64}$",
          "description": "Loopback only, with the per-launch token. This response is the only copy of the URL outside the dashboard process."
        }
      }
    },
    "otherInstallsRequest": {
      "type": "object",
      "required": ["protocol", "type", "request_id", "install_id"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "other_installs" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "install_id": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9-]{36}$",
          "description": "The caller's install identity; used only to exclude one matching status record from the count."
        }
      }
    },
    "otherInstallsResponse": {
      "type": "object",
      "required": ["protocol", "type", "ok", "request_id", "count"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "other_installs" },
        "ok": { "const": true },
        "request_id": { "$ref": "#/$defs/requestId" },
        "count": { "type": "integer", "minimum": 0 }
      },
      "description": "The archive's readable latest per-install status row count excluding one matching local install. No install ids or platform details are returned."
    },
    "identityStateRequest": {
      "type": "object",
      "required": ["protocol", "type", "request_id", "install_id"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "identity_state" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "install_id": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9-]{36}$",
          "description": "The install identity being asked about. Read-only: the host answers from its own coordination state and writes nothing, so this works for an install whose backfill is off and which therefore never sends a status report."
        }
      }
    },
    "identityStateResponse": {
      "type": "object",
      "required": ["protocol", "type", "ok", "request_id", "identity_conflict"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "identity_state" },
        "ok": { "const": true },
        "request_id": { "$ref": "#/$defs/requestId" },
        "identity_conflict": {
          "type": "boolean",
          "description": "True when two live writers have been observed sharing this install id, which one `report_seq` arriving under two different `report_nonce` values proves. False means no collision has been observed yet — not proof that only one copy exists: two copies are indistinguishable until they allocate the same sequence (ADR-045)."
        }
      },
      "description": "EXT-13. Whether this install id is known to be shared by more than one live copy. No other install's data is returned."
    },
    "statusRequest": {
      "type": "object",
      "required": [
        "protocol",
        "type",
        "request_id",
        "status"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "type": {
          "const": "status"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        },
        "status": {
          "type": "object"
        }
      },
      "description": "A content-free per-install status snapshot; the host adds machine and schema fields."
    },
    "statusResponse": {
      "type": "object",
      "required": [
        "protocol",
        "type",
        "ok",
        "request_id"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "type": {
          "const": "status"
        },
        "ok": {
          "const": true
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        }
      }
    }
  }
}
