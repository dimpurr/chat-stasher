{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dimpurr/chat-stasher/contracts/inbox.schema.json",
  "title": "chat-stasher inbox bundle",
  "description": "Inbox bundles from web captures or encoded harness-file slices. Schema, TypeScript validators and Rust parsing change together. Legacy @1/@2 remain accepted.",
  "type": "object",
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "enum": [
        "chat-stasher/inbox@1",
        "chat-stasher/inbox@2",
        "chat-stasher/inbox@3"
      ],
      "description": "@1 has no identity field; the CLI reads an @1 bundle as identity {level:'default', value:''}."
    },
    "platform": {
      "type": "string",
      "examples": [
        "deepseek"
      ]
    },
    "sessionId": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "status": {
      "type": "integer"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "parsed": {
      "type": "object",
      "description": "Best-effort envelope fields. Not authoritative.",
      "properties": {
        "hasJson": {
          "type": "boolean"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "level",
        "value"
      ],
      "description": "Since @2. For web platforms the identity axis is the account, not the machine (ADR-002): two machines capturing the same conversation must produce the same id so it dedups. level 'default' means the identity is unreliable, and the CLI must fall back to platform:sessionId as the dedup key.",
      "properties": {
        "level": {
          "enum": [
            "platform_uid",
            "email",
            "handle",
            "default"
          ]
        },
        "value": {
          "type": "string"
        }
      }
    },
    "account": {
      "description": "Since @2 (W128 step 1). An irreversible account fingerprint: HMAC-SHA256, keyed with a random salt this install keeps in storage.local and never syncs, over a domain- and platform-separated message containing the platform's stable account/org id. The raw id is never written, and no email is ever used as the input. A bundle either carries a fingerprint or carries the named fact that it does not; there is no third, empty spelling. '@1' bundles have no `account` key at all, which is a different statement from kind 'unknown'. The CLI stores this envelope verbatim and it takes no part in the id or the dedup key, which remain platform.sessionId and file_sha256.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "value",
            "source",
            "saltId"
          ],
          "properties": {
            "kind": {
              "const": "fingerprint"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "Lowercase hex HMAC-SHA256."
            },
            "source": {
              "enum": [
                "request-url-organization",
                "response-body-platform-uid",
                "request-header-chatgpt-account-id",
                "response-body-claude-whoami",
                "response-body-claude-user-settings"
              ],
              "description": "Where the input id came from. 'request-url-organization' is a path segment of the page's own request (verified, page-owned). 'response-body-platform-uid' is the ADR-002 account axis read from the captured body by the generic scan, whose candidate key names are not confirmed against a logged-in page. 'request-header-chatgpt-account-id' (W299) is the ChatGPT-Account-Id value on the exact request whose response this capture is; it is untrusted page input. 'response-body-claude-whoami' (W337) is the current-user id read from a cache-disabled Claude who-am-I response. 'response-body-claude-user-settings' (W337) is the userId from the captured organization's Claude Code user_settings response, used only if who-am-I supplied no id. Both Claude values are transient raw inputs; only the per-install HMAC is recorded."
            },
            "saltId": {
              "type": "string",
              "description": "The public half of this install's salt: an opaque per-install id, not the key, and not derivable from it. Two fingerprints may only be compared when their saltId values are equal; a per-install salt makes values from different installs or profiles incomparable, and that must not be read as an account switch. It exists so that limit is visible in the archive instead of being inferred wrongly."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unknown"
            },
            "reason": {
              "enum": [
                "platform-not-recognized",
                "organization-not-in-request-url",
                "organization-is-not-an-account",
                "no-account-id-in-capture",
                "account-id-unreadable",
                "email-is-not-an-account-id",
                "handle-is-not-an-account-id",
                "salt-unavailable",
                "salt-unreadable",
                "crypto-unavailable"
              ],
              "description": "Every value is a distinct fact. 'organization-is-not-an-account' (W239) means this platform files conversations under an organization, which two accounts can share: a value derived from it would be equal for both, so no value is recorded and the reason says why. 'account-id-unreadable' (W337) means a current-user endpoint could not be read or parsed; it is distinct from a completed lookup with no user id. 'salt-unreadable' means a salt record exists and does not parse, and is deliberately not replaced by a fresh one: that would re-key every later fingerprint and read as an account switch."
            }
          }
        }
      ]
    },
    "install_id": {
      "type": "string",
      "minLength": 1,
      "description": "Since W205. Stable UUID for this extension install, generated once per browser profile and kept in storage.local. Older inbox@2 bundles may omit it."
    },
    "browser": {
      "type": "string",
      "minLength": 1,
      "description": "Since W205. Best-effort browser name for the profile that produced the bundle."
    },
    "profile_label": {
      "type": "string",
      "minLength": 1,
      "description": "Since W205. User-provided browser profile label; older bundles may omit it. Until the user names the profile in the popup, bundles carry the literal placeholder \"Unnamed profile\". The placeholder is not an identity claim: hosts must not treat it as establishing or violating an install-id binding (see EXT-2 / D4). The popup saves a label once and has no rename step today; directly editing the stored record afterwards, once a first user-named label was already sealed under this install_id, makes later bundles carry a second user-named label under the same install_id, which hosts refuse until that install regenerates its identity."
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Since W213. The content fingerprint of the capture this bundle was built from: sha256 of `platform` + newline + the raw body as JSON with only that platform's known volatile top-level fields removed (apps/extension/lib/recapture.ts `contentFingerprint`). It is the same value the deliver message's optional `fingerprint` carries (§6.2), placed inside the bundle because the §8 export file holds the payload and nothing else — that way `chat-stasher ingest` of an export line seals the fingerprint onto the shard and `has` (§6.6) answers for content that entered through the manual channel. The host treats it as opaque and never recomputes it. Optional: a platform with no volatile-field table has no derivation, a non-JSON body has none, and every bundle from a build before this field omits the key — absence stays absence. The field is derived from the body the bundle already carries and takes no part in the id or the dedup key, which remain platform.sessionId and file_sha256."
    },
    "provenance": {
      "type": "object",
      "description": "Immutable ChatGPT source facts recorded at capture. project='unknown' means membership had not been resolved; it is not no-project.",
      "required": ["workspace", "project", "archived"],
      "properties": {
        "workspace": { "type": "string", "minLength": 1 },
        "project": {
          "oneOf": [
            { "type": "null" },
            { "const": "unknown" },
            { "type": "object", "required": ["id", "name"], "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 }
            } }
          ]
        },
        "archived": { "type": "boolean" }
      }
    },
    "dimensions": {
      "type": "object",
      "description": "Optional normalized session provenance. Each dimension contains observed values only; an empty array means no value was recorded, while the literal unknown remains explicit.",
      "properties": {
        "surface": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "tenant": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "container": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "cwd": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 },
          "description": "Working directories the source itself recorded, spelled as it spelled them. An OS execution location, never a repository or workspace identity; a session that moved records every place it ran, not only the last." },
        "status": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "provenanceSupplement": {
      "type": "object",
      "description": "Append-only later observation. Consumers retain provenance.project as the original capture fact.",
      "required": ["workspace", "project", "source", "observedAt"],
      "properties": {
        "workspace": { "type": "string", "minLength": 1 },
        "project": { "oneOf": [ { "type": "null" }, { "type": "object", "required": ["id", "name"], "properties": {
          "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }
        } } ] },
        "source": { "enum": ["project-list", "project-enumeration-complete"] },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "schema": {
          "enum": [
            "chat-stasher/inbox@1",
            "chat-stasher/inbox@2"
          ]
        },
        "raw": {
          "type": "object",
          "required": [
            "text",
            "bytes"
          ],
          "description": "The raw response. Authoritative: a wrong parse can always be redone from here.",
          "properties": {
            "text": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            }
          }
        }
      },
      "required": [
        "platform",
        "sessionId",
        "raw"
      ]
    },
    {
      "properties": {
        "schema": {
          "const": "chat-stasher/inbox@3"
        },
        "kind": {
          "enum": [
            "web-capture",
            "harness-file"
          ]
        },
        "fidelity": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "const": "raw"
                }
              },
              "required": [
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "value": {
                  "const": "full"
                },
                "representation": {
                  "enum": [
                    "api",
                    "decoded",
                    "export"
                  ]
                }
              },
              "required": [
                "value",
                "representation"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "value": {
                  "const": "partial"
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "value",
                "note"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "value": {
                  "const": "unknown"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "value",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        },
        "producer": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "send",
                "extension",
                "collect",
                "ingest"
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "platform": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,254}$"
            },
            "sendKeyId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,254}$"
            }
          },
          "required": [
            "kind",
            "version"
          ],
          "additionalProperties": false
        },
        "platformRefs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,254}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,254}$"
          }
        },
        "harness": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,254}$"
        },
        "nativeSessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,254}$"
        },
        "file": {
          "type": "object",
          "properties": {
            "role": {
              "enum": [
                "transcript",
                "subagent",
                "tool-result",
                "other"
              ]
            },
            "relPath": {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
            },
            "byteStart": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "byteEnd": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "parentNativeSessionId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,254}$"
            }
          },
          "required": [
            "role",
            "relPath",
            "byteStart",
            "byteEnd",
            "sha256"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "role": {
                    "const": "subagent"
                  }
                }
              },
              "then": {
                "required": [
                  "parentNativeSessionId"
                ]
              }
            }
          ]
        },
        "platform": {},
        "sessionId": {},
        "url": {},
        "method": {},
        "status": {},
        "capturedAt": {},
        "parsed": {},
        "identity": {},
        "account": {},
        "install_id": {},
        "browser": {},
        "profile_label": {},
        "fingerprint": {},
        "provenance": {},
        "dimensions": {},
        "provenanceSupplement": {},
        "raw": {}
      },
      "required": [
        "kind",
        "fidelity"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "web-capture"
            },
            "raw": {
              "type": "object",
              "required": [
                "text",
                "bytes"
              ],
              "description": "The raw response. Authoritative: a wrong parse can always be redone from here.",
              "properties": {
                "text": {
                  "type": "string"
                },
                "bytes": {
                  "type": "integer"
                }
              }
            },
            "fidelity": {
              "not": {
                "properties": {
                  "value": {
                    "const": "raw"
                  }
                }
              }
            },
            "platform": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "platform",
            "sessionId",
            "raw"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "harness"
                ]
              },
              {
                "required": [
                  "nativeSessionId"
                ]
              },
              {
                "required": [
                  "file"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "harness-file"
            },
            "raw": {
              "type": "object",
              "properties": {
                "encoding": {
                  "enum": [
                    "utf-8",
                    "base64"
                  ]
                },
                "data": {
                  "type": "string"
                }
              },
              "required": [
                "encoding",
                "data"
              ],
              "additionalProperties": false
            },
            "identity": {
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "const": ""
                    },
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,254}$"
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "level": {
                        "const": "default"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "const": ""
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "value": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,254}$"
                      }
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "harness",
            "nativeSessionId",
            "file",
            "raw"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "platform"
                ]
              },
              {
                "required": [
                  "sessionId"
                ]
              }
            ]
          }
        }
      ],
      "additionalProperties": false,
      "$comment": "Fidelity is captured, never a registry declaration. Runtime validation additionally checks canonical encoding, decoded slice length, ordered bounds and SHA-256. Standard JSON Schema validates structure only. Archive wiring for harness-file is a separate delivery."
    }
  ]
}
